{
  "name": "i18n",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "vp run -r build",
    "changeset": "changeset",
    "check": "vp run quality",
    "ci": "pnpm check && pnpm build && pnpm verify:packages && pnpm verify:release",
    "dev": "vp run playground#dev",
    "docs:build": "vp run docs#build",
    "docs:dev": "vp run docs#dev",
    "docs:preview": "vp run docs#preview",
    "format": "vp fmt --write .",
    "format:check": "vp fmt --check .",
    "hooks:install": "vp config --hooks-dir .vite-hooks --no-agent",
    "lint": "vp lint . --max-warnings=0",
    "lint:fix": "vp lint . --fix --max-warnings=0",
    "preview": "vp run playground#preview",
    "ready": "pnpm run ci",
    "release": "pnpm ready && changeset publish",
    "test": "vp run -r test",
    "typecheck": "tsc -p tsconfig.json --noEmit && vp run -r typecheck",
    "verify:packages": "vp run -r verify:package",
    "verify:release": "node scripts/verify-release.mjs",
    "version-packages": "changeset version && pnpm install --lockfile-only --no-frozen-lockfile"
  },
  "devDependencies": {
    "@changesets/cli": "catalog:",
    "@commitlint/cli": "catalog:",
    "@commitlint/config-conventional": "catalog:",
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vite-plus": "catalog:"
  }
}
