{
  "name": "i18n",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "vp run -r build",
    "changeset": "changeset",
    "check": "vp run quality",
    "ci": "pnpm check && pnpm build && pnpm verify:packages && pnpm verify:release",
    "dev": "pnpm dev:vue",
    "dev:hono": "vp run playground-hono#dev",
    "dev:react": "vp run playground-react#dev",
    "dev:vue": "vp run playground-vue#dev",
    "docs:build": "vp run docs#build",
    "docs:dev": "vp run docs#dev",
    "docs:preview": "vp run docs#preview",
    "format": "vp fmt --write .",
    "format:check": "vp fmt --check .",
    "hooks:install": "vp config --hooks-dir .vite-hooks --no-agent",
    "i18n:check": "pnpm --filter \"playground-*\" i18n:check",
    "i18n:export": "pnpm --filter \"playground-*\" i18n:export",
    "i18n:import": "pnpm --filter \"playground-*\" i18n:import",
    "i18n:sync": "pnpm --filter \"playground-*\" i18n:sync",
    "lint": "vp lint . --max-warnings=0 && pnpm --filter playground-vue lint",
    "lint:fix": "vp lint . --fix --max-warnings=0 && pnpm --filter playground-vue exec eslint . --fix --max-warnings=0",
    "preview": "pnpm preview:vue",
    "preview:hono": "vp run playground-hono#preview",
    "preview:react": "vp run playground-react#preview",
    "preview:vue": "vp run playground-vue#preview",
    "ready": "pnpm run ci",
    "release": "pnpm ready && changeset publish",
    "release:ci": "pnpm --filter \"./packages/*\" run build && pnpm verify:packages && changeset publish",
    "test": "vp run -r test",
    "typecheck": "tsc -p tsconfig.json --noEmit && vp run -r typecheck",
    "verify:packages": "vp run -r verify:package",
    "verify:release": "node scripts/verify-release.mjs",
    "version-packages": "changeset version && pnpm install --lockfile-only --no-frozen-lockfile"
  },
  "devDependencies": {
    "@changesets/cli": "catalog:",
    "@commitlint/cli": "catalog:",
    "@commitlint/config-conventional": "catalog:",
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vite-plus": "catalog:"
  },
  "engines": {
    "node": "26.x",
    "pnpm": "12.x"
  },
  "packageManager": "pnpm@12.11.2"
}
