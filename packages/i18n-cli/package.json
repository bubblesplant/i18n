{
  "name": "@bubblesjs/i18n-cli",
  "version": "0.0.2",
  "description": "扫描静态翻译调用、同步 JSON 语言包并双向转换 Excel 翻译表的命令行工具",
  "license": "MIT",
  "bin": {
    "bubbles-i18n": "./dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "vp run bundle",
    "test": "vp test run",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "verify:package": "node ../../scripts/verify-package.mjs",
    "prepublishOnly": "pnpm build && pnpm verify:package"
  },
  "dependencies": {
    "exceljs": "catalog:",
    "fast-glob": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vite-plus": "catalog:"
  }
}
